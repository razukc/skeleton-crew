{
  "name": "calypso-dogfood",
  "version": "1.0.0",
  "description": "Dogfood: run CalypsoBot's command layer on skeleton-crew",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "live": "npm run build && node dist/src/runtime/live.js"
  },
  "dependencies": {
    "skeleton-crew": "file:../..",
    "discord.js": "^14.16.0",
    "dayjs": "^1.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.15"
  }
}
